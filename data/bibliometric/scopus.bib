	doi = {10.1098/rstb.2017.0282},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85052535292&doi=10.1098%2frstb.2017.0282&partnerID=40&md5=60c3db65d9522cdd628008b80b88f3e2},
	affiliations = {Department of Evolution, Ecology and Behaviour, Institute of Integrative Biology, University of Liverpool, Liverpool, L69 7RB, United Kingdom; School of Biology, University of St. Andrews, St. Andrews, Fife, KY16 9TH, United Kingdom; Department of Psychology, University of Alberta, Edmonton, T6G 2R3, AB, Canada},
	abstract = {In the past decade, several conceptual papers have linked variation in animal personality to variation in cognition, and recent years have seen a flood of empirical studies testing this link. However, these results have not been synthesized in a quantitative way. Here, we systematically search the literature and conduct a phylogenetically controlled meta-analysis of empirical papers that have tested the relationship between animal personality (exploration, boldness, activity, aggression and sociability) and cognition (initial learning/reversal speed, number of correct choices/errors after standard training). We find evidence for a small but significant relationship between variation in personality and variation in learning across species in the absolute scale; however, the direction of this relationship is highly variable and when both positive and negative effect sizes are considered, the average effect size does not differ significantly from zero. Importantly, this variation among studies is not explained by differences in personality or learning measure, or taxonomic grouping. Further, these results do not support current hypotheses suggesting that that fast-explorers are fast-learners or that slow-explorers perform better on tests of reversal learning. Rather, we find evidence that bold animals are faster learners, but only when boldness is measured in response to a predator (or simulated predator) and not when boldness is measured by exposure to a novel object (or novel food). Further, although only a small sub-sample of papers reported results separately for males and females, sex explained a significant amount of variation in effect size. These results, therefore, suggest that, while personality and learning are indeed related across a range of species, the direction of this relationship is highly variable. Thus further empirical work is needed to determine whether there are important moderators of this relationship. This article is part of the theme issue ‘Causes and consequences of individual differences in cognitive abilities’. © 2018 The Author(s) Published by the Royal Society. All rights reserved.},
	author_keywords = {Behavioural syndrome; Exploration; Individual differences; Learning; Sex differences},
	keywords = {Animals; Behavior, Animal; Cognition; Personality; Animalia; cognition; empirical analysis; exploration; individual variation; learning; meta-analysis; phylogenetics; sex-related difference; social behavior; animal; animal behavior; cognition; meta analysis; personality},
	correspondence_address = {L.M. Guillette; School of Biology, University of St. Andrews, St. Andrews, Fife, KY16 9TH, United Kingdom; email: guillett@ualberta.ca},
